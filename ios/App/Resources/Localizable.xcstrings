    "app.household.getting_around.lede": {
      "comment": "Shown at the top of Getting around. Official desks, no live bus dots.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official desks for this pin: crash corridors, night walking, reported crime maps, flood, parking, ride-app stands, and 311. Not live bus dots. Not a neighborhood score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escritorios oficiales para caminar, viajar e iluminar este pin. No es el bus en vivo."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biwo ofisyèl pou mache, vwayaje, ak limyè nan pin sa a. Se pa bis an dirèk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Balcões oficiais para caminhar, circular e iluminar este pin. Não é ônibus ao vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guichets officiels pour marcher, rouler et l’éclairage de ce pin. Pas de bus en direct."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مكاتب رسمية للمشي والتنقل والإنارة عند هذا الموقع. ليست حافلات مباشرة."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本地址步行、乘车和路灯的官方窗口。不是实时公交。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Официальные окна для этой точки: пешком, поездка и свет. Это не живые автобусы."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opisyal na tanggapan para sa lakad, sakay, at ilaw ng pin na ito. Hindi live na bus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quầy chính thức cho đi bộ, đi xe và đèn tại ghim này. Không phải xe buýt trực tiếp."
          }
        }
      }
    },
