    "app.scene.vehicle.law": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If anyone is hurt, or damage looks at least $500, contact local law enforcement now. (Fla. Stat. 316.065 / FLHSMV)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si hay heridos o el daño parece de al menos $500, contacte a la policía ahora. (Fla. Stat. 316.065 / FLHSMV)"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si gen moun blese, oswa domaj la sanble omwen $500, kontakte lapolis kounye a. (Fla. Stat. 316.065 / FLHSMV)"
          }
        }
      }
    },
    "app.scene.vehicle.exchange": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your name, address, and vehicle registration. Show your license if asked. Help if someone is hurt. (Fla. Stat. 316.062)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dé su nombre, dirección y matrícula. Muestre la licencia si se la piden. Ayude si hay heridos. (Fla. Stat. 316.062)"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bay non, adrès, ak enskripsyon machin nan. Montre lisans si yo mande. Ede si gen moun blese. (Fla. Stat. 316.062)"
          }
        }
      }
    },
    "app.scene.vehicle.photo": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a record of the plate, the damage, and the Driver Exchange of Information form at flhsmv.gov/traffic-crash-reports/. This app does not decide what a photo proves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarde la placa, el daño y el formulario de intercambio en flhsmv.gov/traffic-crash-reports/. Esta app no decide lo que prueba una foto."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kenbe plak, domaj, ak fòm echanj enfòmasyon sou flhsmv.gov/traffic-crash-reports/. Aplikasyon an pa deside sa yon foto pwouve."
          }
        }
      }
    },
    "app.scene.vehicle.fault": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not decide fault. The duty to report to an officer does not extend to information that would violate the privilege against self-incrimination. (Fla. Stat. 316.062(3))"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta app no decide la culpa. El deber de informar a un oficial no incluye información que viole el privilegio contra la autoincriminación. (Fla. Stat. 316.062(3))"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplikasyon an pa deside kilè ki fò. Deva pou rapòte bay ofisye a pa pwolonje sou enfòmasyon ki vyole privilèj kont auto-akizasyon. (Fla. Stat. 316.062(3))"
          }
        }
      }
    },
    "app.scene.vehicle.forms": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FLHSMV customer service: (850) 617-2000. Insurance Request Form HSMV 83392 is on flhsmv.gov. Notify your own insurer; this app does not have that number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atención FLHSMV: (850) 617-2000. El formulario HSMV 83392 está en flhsmv.gov. Aviso a su aseguradora; esta app no tiene ese número."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sèvis FLHSMV: (850) 617-2000. Fòm HSMV 83392 sou flhsmv.gov. Avèti asirans pa w; aplikasyon an pa gen nimewo sa a."
          }
        }
      }
    },
    "app.scene.home.311": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "311 is the non-emergency desk for a leak, a dark stop, or a building problem. English, Spanish, or Haitian Creole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "311 es el escritorio no urgente para una gotera, una parada oscura o un problema del edificio. Inglés, español o criollo."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "311 se biwo ki pa ijans pou yon koule, yon arè nwa, oswa yon pwoblèm bilding. Angle, panyòl oswa kreyòl."
          }
        }
      }
    },
    "app.scene.home.flood": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pin’s flood zone and storm evacuation zone are on the Flood card. 311 owns the report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La zona de inundación y evacuación de este pin están en la tarjeta de inundación. 311 recibe el reporte."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zòn inondasyon ak evakyasyon pin sa a sou kat inondasyon an. 311 resevwa rapò a."
          }
        }
      }
    },
    "app.scene.home.cannot": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo cannot prove the building is unsafe or that a landlord owes a deposit. The desk decides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta foto no prueba que el edificio sea inseguro ni que el casero deba el depósito. El escritorio decide."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foto sa a pa pwouve bilding lan pa an sekirite oswa ke pwopriyetè a dwe depo a. Biwo a deside."
          }
        }
      }
    },
    "app.scene.unreadable.step": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This frame cannot be read. Take another photo in more light, of the bumper, wall, or leak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede leer este encuadre. Tome otra foto con más luz, del parachoques, la pared o la gotera."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yo pa ka li kad sa a. Fè yon lòt foto ak plis limyè, sou dèyè machin, miray, oswa koule."
          }
        }
      }
    },
    "app.scene.person.step": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person is in this photo. Point the camera at the car, the wall, or the leak — not a face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay una persona en esta foto. Apunte al auto, la pared o la gotera, no a un rostro."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gen yon moun nan foto sa a. Vize machin, miray, oswa koule a — pa yon figi."
          }
        }
      }
    },
    "app.scene.vehicle.snap": {
      "comment": "What to photograph after a bumper tap.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph the plate, the scuff, both vehicles, and the street. Do not photograph a face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotografíe la placa, el golpe, ambos vehículos y la calle. No fotografíe un rostro."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fè foto plak la, chòk la, tou de machin yo, ak lari a. Pa fè foto yon figi."
          }
        }
      }
    },
    "app.scene.vehicle.insurance": {
      "comment": "Insurance floor after a crash. No claim, no payout.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Florida requires PIP and $10,000 property-damage liability to drive. Notify your own insurer; this app does not file a claim or have that number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Florida exige PIP y $10,000 de responsabilidad por daños a la propiedad para manejar. Avise a su aseguradora; esta app no presenta un reclamo ni tiene ese número."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Florid mande PIP ak $10,000 responsablite pou domaj pwopriyete pou kondwi. Avèti asirans pa w; aplikasyon an pa depoze reklam ni pa gen nimewo sa a."
          }
        }
      }
    },
    "app.scene.home.snap": {
      "comment": "What to photograph for a house problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph the leak or damage on the wall, ceiling, or floor. Point away from faces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fotografíe la gotera o el daño en la pared, el techo o el piso. No apunte a un rostro."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fè foto koule a oswa domaj sou miray, plafon, oswa planche. Pa vize figi."
          }
        }
      }
    },
    "app.scene.cannot.vehicle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo cannot prove who was at fault, a dollar amount, or whether a policy will pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta foto no prueba quién tuvo la culpa, un monto, ni si una póliza pagará."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foto sa a pa pwouve kilè ki fò, yon montan, oswa si yon asirans ap peye."
          }
        }
      }
    },
    "app.scene.cannot.home": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo cannot prove the building is unsafe, that a landlord owes a deposit, or that damage is structural."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta foto no prueba que el edificio sea inseguro, que el casero deba un depósito, ni que el daño sea estructural."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Foto sa a pa pwouve bilding lan pa an sekirite, ke pwopriyetè a dwe yon depo, oswa ke domaj la se estriktirèl."
          }
        }
      }
    },
