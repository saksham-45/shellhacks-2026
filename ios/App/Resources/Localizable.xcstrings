    "app.voice.gemini_share": {
      "comment": "Assurant/Microsoft disclosure. Gemini classifies; it does not see papers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The words you say go to Gemini only to pick a card. Papers and status stay on the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las palabras que dice van a Gemini solo para elegir una tarjeta. Los papeles y el estatus se quedan en el teléfono."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mo ou di yo ale nan Gemini sèlman pou chwazi yon kat. Papye ak estati rete sou telefòn nan."
          }
        }
      }
    },
    "app.voice.elevenlabs": {
      "comment": "ElevenLabs reads the card, including Kreyòl. Never a Spanish voice on Creole.",
