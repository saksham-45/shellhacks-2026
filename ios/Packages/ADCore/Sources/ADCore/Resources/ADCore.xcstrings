      "comment": "Shown and spoken before an onboarding question is asked again, after an answer was not accepted. One short sentence or two.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That person is not in this household yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa persona todavía no está en este hogar."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Moun sa a poko nan kay sa a."
          }
        }
      }
    },
    "onboarding.error.unnamed_person": {
      "comment": "Shown and spoken before an onboarding question is asked again, after an answer was not accepted. One short sentence or two.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person needs a name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada persona necesita un nombre."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chak moun bezwen yon non."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada pessoa precisa de um nome."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chaque personne a besoin d’un nom."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "كل شخص يحتاج إلى اسم."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个人都需要一个名字。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
