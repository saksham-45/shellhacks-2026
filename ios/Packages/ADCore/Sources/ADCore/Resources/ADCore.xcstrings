          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kailangan ng pangalan ang bawat tao."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mỗi người cần một tên."
          }
        }
      }
    },
    "onboarding.q1": {
      "comment": "Onboarding question 1 of 4, shown and spoken (plan, 'Who it is for', verbatim, ending as a real question). Full sentence; wraps, no length limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where are you sleeping, or where is the pin?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde está durmiendo, o cuál es el punto en el mapa?"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ki kote w ap dòmi, oswa ki pwen an sou kat la?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Onde você está dormindo, ou onde está o pin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Où dormez-vous, ou où est l’épingle ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أين تنام، أو أين الدبوس؟"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你住在哪里，或者图钉在哪里？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Где вы ночуете, или где булавка?"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saan ka natutulog, o nasaan ang pin?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn ngủ ở đâu, hoặc ghim ở đâu?"
          }
        }
      }
    },
    "onboarding.q2": {
      "comment": "Onboarding question 2 of 4, shown and spoken (plan, 'Who it is for': who is in the household, each as their own person). ONE question ending in a real question mark; no trailing statement (a listener must hear it end as a question). Full sentence; wraps, no length limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who is in your household, including you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quiénes viven en su hogar, incluyéndose a usted?"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ki moun ki fè pati kay ou a, ou menm tou?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quem mora na casa, incluindo você?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qui habite avec vous, vous compris ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "من في أسرتك، بما فيك؟"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "家里有谁，包括你？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Кто в семье, включая вас?"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sino ang nasa sambahayan, kasama ka?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ai trong hộ, kể cả bạn?"
          }
        }
      }
    },
    "onboarding.q3": {
      "comment": "Onboarding question 3 of 4, shown and spoken (plan, 'Who it is for', ending as a real question). Full sentence; wraps, no length limit. Asked once per person; the UI plays onboarding.about_person (with that person's name) right before it, so the question itself does not name the person.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did this person live before, and what language do they actually think in?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde vivía esta persona antes, y en qué idioma piensa de verdad?"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ki kote moun sa a te rete anvan, e nan ki lang li reyèlman panse?"
          }
        }
      }
    },
    "onboarding.q4": {
      "comment": "Onboarding question 4 of 4, shown and spoken (plan, 'Who it is for', ending as a real question). Full sentence; wraps, no length limit. Asked once per person; the UI plays onboarding.about_person (with that person's name) right before it, so the question itself does not name the person.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are they here to do right now: arrive, study, work, reunite, visit, or just get through this week?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué vino a hacer esta persona ahora mismo: llegar, estudiar, trabajar, reunirse con la familia, visitar, o salir adelante esta semana?"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kisa moun sa a vin fè isit kounye a: rive, etidye, travay, rejwenn fanmi, vizite, oswa jis pase semèn sa a?"
          }
        }
      }
    },
    "source_line.no_source": {
      "comment": "Card footer when no fact on the card has a source; the desk's name and contact follow. One or two short sentences.",
