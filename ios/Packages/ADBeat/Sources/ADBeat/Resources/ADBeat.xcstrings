    "beat.replay.chip": {
      "comment": "Small chip shown on any beat playing its saved replay instead of running live, so judges are never misled. Honest wording: says 'replay, not live' and never claims a recording (the replays are saved or authored demo output, not recordings). '·' is a separator. | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. | ht: Haitian Creole draft 'Repetisyon · se pa an dirèk' (repetisyon = replay, an dirèk = live), drafted by the myAD Language agent; not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay · not live"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetición · no es en vivo"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Repetisyon · se pa an dirèk"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Replay · não ao vivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Replay · pas en direct"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إعادة · ليست مباشرة"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回放 · 非实时"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повтор · не в прямом эфире"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Replay · hindi live"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phát lại · không trực tiếp"
          }
        }
      }
    },
    "beat.replay.chipA11y": {
      "comment": "VoiceOver label for the replay chip: a full sentence saying the result is a saved replay, not live. Never says 'recorded' (the replays are not recordings). | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. | ht: Haitian Creole draft (sere = kept/saved, an dirèk = live), drafted by the myAD Language agent; not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a saved replay, not a live result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una repetición guardada, no un resultado en vivo."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sa a se yon repetisyon ki te sere, se pa yon rezilta an dirèk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Isto é um replay salvo, não um resultado ao vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ceci est un replay enregistré, pas un résultat en direct."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذه إعادة محفوظة وليست نتيجة مباشرة."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这是保存的回放，不是实时结果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это сохранённый повтор, не живой результат."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naka-save na replay ito, hindi live."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đây là bản phát lại đã lưu, không phải kết quả trực tiếp."
          }
        }
      }
    },
