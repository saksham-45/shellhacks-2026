            "value": "Mòd Grann"
          }
        }
      }
    },
    "beat.cold_open.line": {
      "comment": "Static cold-open line of the demo. Sofi is a name; 15 is her age. | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. | ht: Haitian Creole drafted by the myAD Language agent; not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofi is 15. Until today she was this family's interpreter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofi tiene 15 años. Hasta hoy, era la intérprete de esta familia."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sofi gen 15 an. Jiska jodi a, se li ki te entèprèt fanmi sa a."
          }
        }
      }
    },
