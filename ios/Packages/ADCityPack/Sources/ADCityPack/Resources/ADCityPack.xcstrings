{
  "sourceLanguage": "en",
  "strings": {
    "regions.address.bulky-book": {
      "comment": "Who handles my address: county bulky-waste area. %1$@ area label as returned, %2$@ fallback desk.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulky trash: county bulky-waste area %1$@. Ask %2$@ for the pickup date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Basura voluminosa: zona %1$@ del condado. Pregunte a %2$@ la fecha de recogida."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gwo fatra: zòn %1$@ konte a. Mande %2$@ dat ranmasaj la."
          }
        }
      }
    },
    "regions.address.bulky-day": {
      "comment": "Who handles my address: City of Miami bulky trash day from the city code list. %1$@ day.",
