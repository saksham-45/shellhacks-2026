      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The state charges %1$@ for %2$@, plus up to %3$@ at a Tax Collector office. Source: %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El estado cobra %1$@ por %2$@, más hasta %3$@ en una oficina del Tax Collector. Fuente: %4$@."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leta a mande %1$@ pou %2$@, plis jiska %3$@ nan yon biwo Tax Collector. Sous: %4$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Estado cobra %1$@ por %2$@, mais até %3$@ no Tax Collector. Fonte: %4$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’État facture %1$@ pour %2$@, plus jusqu’à %3$@ au Tax Collector. Source : %4$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تفرض الولاية %1$@ مقابل %2$@، بالإضافة إلى ما يصل إلى %3$@ في مكتب جابي الضرائب. المصدر: %4$@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "州收取 %1$@ 用于 %2$@，税务官办公室最多另收 %3$@。来源：%4$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Штат берёт %1$@ за %2$@, плюс до %3$@ в офисе Tax Collector. Источник: %4$@."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sisingilin ng estado ang %1$@ para sa %2$@, plus hanggang %3$@ sa Tax Collector. Source: %4$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiểu bang thu %1$@ cho %2$@, cộng tối đa %3$@ tại Tax Collector. Nguồn: %4$@."
          }
        }
      }
    },
