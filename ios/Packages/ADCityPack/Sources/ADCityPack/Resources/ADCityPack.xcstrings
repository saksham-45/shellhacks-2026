            "state": "needs_review",
            "value": "Gwo fatra: %1$@."
          }
        }
      }
    },
    "regions.address.cached": {
      "comment": "Who handles my address: a saved county answer (replay chip, or the live check timed out). %1$@ date it was recorded.",
