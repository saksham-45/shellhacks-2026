    "regions.listing.verdict.condo-needs-unit": {
      "comment": "Listing Check: condo building, no unit given. No verdict.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is a condo building. Say the unit number so I can compare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es un edificio de condominios. Diga el número de la unidad para comparar."
          }
