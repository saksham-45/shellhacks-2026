          "stringUnit": {
            "state": "needs_review",
            "value": "Se yon bilding kondo. Di nimewo inite a pou m ka konpare."
          }
        }
      }
    },
    "regions.listing.verdict.does-not-match": {
      "comment": "Listing Check: owner of record does not match. Never say scam. %@ the claimed name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "According to the county record, the owner of that property is not named %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Según el registro del condado, el dueño de esa propiedad no se llama %@."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dapre dosye konte a, pwopriyetè kay sa a pa rele %@."
          }
        }
      }
    },
    "regions.listing.verdict.matches": {
