{
  "sourceLanguage": "en",
  "strings": {
    "router.ask.call_desk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call this desk? This leaves the app. Say yes or no."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Llamar a esta oficina? Esto sale de la app. Diga sí o no."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rele biwo sa a? Sa ap fè w soti nan aplikasyon an. Di wi oswa non."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ligar para este balcão? Isso sai do app. Diga sim ou não."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appeler ce guichet ? Cela quitte l’app. Dites oui ou non."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الاتصال بهذا المكتب؟ سيغادر التطبيق. قل نعم أو لا."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拨打该柜台？将离开应用。请说是或否。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позвонить в эту службу? Приложение закроется. Скажите да или нет."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tawagan ang opisina? Aalis sa app. Sabihin oo o hindi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gọi quầy này? Sẽ rời ứng dụng. Nói có hoặc không."
          }
        }
      }
    },
    "router.ask.open_map": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the map? This leaves the app. Say yes or no."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Abrir el mapa? Esto sale de la app. Diga sí o no."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Louvri kat la? Sa ap fè w soti nan aplikasyon an. Di wi oswa non."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abrir o mapa? Isso sai do app. Diga sim ou não."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrir la carte ? Cela quitte l’app. Dites oui ou non."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فتح الخريطة؟ سيغادر التطبيق. قل نعم أو لا."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开地图？将离开应用。请说是或否。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Открыть карту? Приложение закроется. Скажите да или нет."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buksan ang mapa? Aalis sa app. Sabihin oo o hindi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở bản đồ? Sẽ rời ứng dụng. Nói có hoặc không."
          }
        }
      }
    },
    "router.clarify.which_card": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which one did you mean?"
