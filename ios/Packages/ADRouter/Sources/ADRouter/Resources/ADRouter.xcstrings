        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eso no se muestra en modo turista."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yo pa montre sa nan mòd touris."
          }
        }
      }
    },
    "router.refused.ungrounded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't show that: it has no source on this card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
