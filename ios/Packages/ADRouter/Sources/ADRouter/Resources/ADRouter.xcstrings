          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to undo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay nada que deshacer."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pa gen anyen pou anile."
          }
        }
      }
    },
    "router.refused.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That belongs on another person's card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eso va en la tarjeta de otra persona."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sa se sou kat yon lòt moun."
          }
        }
      }
    },
    "router.refused.tourist": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
