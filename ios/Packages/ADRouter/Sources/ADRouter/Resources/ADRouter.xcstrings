    "router.no_answer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't have this. Here is the desk that does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No tengo esto. Esta es la oficina que sí lo tiene."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mwen pa genyen sa. Men biwo ki genyen l lan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não tenho isso. Aqui está o balcão que tem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je n’ai pas ça. Voici le guichet qui l’a."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ليس لدي هذا. هذا هو المكتب المختص."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我没有这项信息。这是负责的柜台。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У меня этого нет. Вот служба, которая знает."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wala ako nito. Ito ang opisina."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tôi không có thông tin này. Đây là quầy phụ trách."
          }
        }
      }
    },
    "router.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't look that up right now."
          }
