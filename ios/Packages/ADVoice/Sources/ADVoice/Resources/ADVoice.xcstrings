{
  "sourceLanguage": "en",
  "strings": {
    "kreyol.couldNotPlay": {
      "comment": "Notice when a reviewed Kreyòl recording exists but failed to play (KreyolPlayback.failed). | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. | ht: Haitian Creole drafted by the myAD Language agent from general knowledge of standard Kreyòl orthography (Akademi Kreyòl Ayisyen spelling). Not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9). | ht casing: 'kreyòl' vs 'Kreyòl' (and 'kre yòl' variants) is inconsistent across strings; the native reviewer should pick one. Not changed by the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't play the Kreyòl recording. The text is on the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reproducir la grabación en Kreyòl. El texto está en la pantalla."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nou pa t ka jwe anrejistreman an Kreyòl la. Tèks la sou ekran an."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível tocar o áudio em kreyòl. O texto está na tela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de lire l’enregistrement kreyòl. Le texte est à l’écran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر تشغيل تسجيل الكريول. النص على الشاشة."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法播放克里奥尔语录音。文字在屏幕上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось воспроизвести креольскую запись. Текст на экране."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hindi na-play ang recording sa Kreyòl. Nasa screen ang teksto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không phát được bản ghi Kreyòl. Chữ ở trên màn hình."
          }
        }
      }
    },
    "kreyol.noRecording": {
      "comment": "Notice when a card has no native-reviewed Creole recording (Play in Kreyòl); no other voice is used instead. | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. | ht: Haitian Creole drafted by the myAD Language agent from general knowledge of standard Kreyòl orthography (Akademi Kreyòl Ayisyen spelling). Not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9). | ht casing: 'kreyòl' vs 'Kreyòl' (and 'kre yòl' variants) is inconsistent across strings; the native reviewer should pick one. Not changed by the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Kreyòl recording yet for this card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay grabación en Kreyòl para esta tarjeta."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poko gen anrejistreman an Kreyòl pou kat sa a."
          }
        }
      }
    },
    "kreyol.play": {
      "comment": "Card action that plays the native-reviewed Creole recording of the card. 'Kreyòl' is the language autonym; keep it. | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. | ht: Haitian Creole drafted by the myAD Language agent from general knowledge of standard Kreyòl orthography (Akademi Kreyòl Ayisyen spelling). Not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9). | ht casing: 'kreyòl' vs 'Kreyòl' (and 'kre yòl' variants) is inconsistent across strings; the native reviewer should pick one. Not changed by the agent.",
