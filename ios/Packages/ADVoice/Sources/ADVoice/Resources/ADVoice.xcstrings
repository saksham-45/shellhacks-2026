            "state": "needs_review",
            "value": "Ouve o que você precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Écoute ce dont vous avez besoin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستمع إلى ما تحتاجه."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "听你需要的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Слушает, что вам нужно."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nakikinig sa kailangan mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nghe điều bạn cần."
          }
        }
      }
    },
