    "confirm.leave_app.map": {
      "comment": "Leave-the-app confirmation before opening Maps (router openMap); %@ is a place or desk name (never translated). Asked aloud and shown with yes/no buttons. | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. UNCERTAIN: 'ir a' before some place names may want 'ir al'; check phrasing. | ht: Haitian Creole drafted by the myAD Language agent from general knowledge of standard Kreyòl orthography (Akademi Kreyòl Ayisyen spelling). Not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9). Uncertain: 'ale' vs 'ale nan' before a place name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the map to go to %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Abrimos el mapa para ir a %@?"
          }
        },
