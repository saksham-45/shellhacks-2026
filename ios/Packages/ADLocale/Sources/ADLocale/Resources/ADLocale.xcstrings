    "fact.source_unavailable": {
      "comment": "Shown instead of a value when the source exists but could not be reached; %@ is the desk name. | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. UNCERTAIN: phrasing 'Pregunte a: <oficina>' should be checked by a Miami Spanish speaker. | ht: Haitian Creole drafted by the myAD Language agent from general knowledge of standard Kreyòl orthography (Akademi Kreyòl Ayisyen spelling). Not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check the source right now. Ask: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No pudimos revisar la fuente ahora. Pregunte a: %@"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nou pa t ka verifye sous la kounye a. Mande: %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível conferir a fonte agora. Pergunte: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de vérifier la source maintenant. Demandez : %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر التحقق من المصدر الآن. اسأل: %@"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "现在无法核对来源。请问：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сейчас не удалось проверить источник. Спросите: %@"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hindi namin na-check ang source ngayon. Tanungin: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hiện không kiểm được nguồn. Hỏi: %@"
          }
        }
