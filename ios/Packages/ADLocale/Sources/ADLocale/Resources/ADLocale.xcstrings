            "value": "Ou vle louvri kat la pou ale %@?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abrir o mapa para ir a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrir la carte pour aller à %@ ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فتح الخريطة للذهاب إلى %@؟"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开地图前往%@？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Открыть карту, чтобы дойти до %@?"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buksan ang mapa papunta sa %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở bản đồ để đến %@?"
          }
        }
      }
