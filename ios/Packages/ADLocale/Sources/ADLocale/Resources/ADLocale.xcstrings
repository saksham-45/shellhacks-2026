    "fact.handed_to_desk": {
      "comment": "Shown instead of a value when a fact has no source; %@ is the desk name (e.g. the county 311 desk). | es: Miami Spanish (US Spanish, usted where addressed), agent-authored; no human review record yet. UNCERTAIN: phrasing 'Pregunte a: <oficina>' should be checked by a Miami Spanish speaker. | ht: Haitian Creole drafted by the myAD Language agent from general knowledge of standard Kreyòl orthography (Akademi Kreyòl Ayisyen spelling). Not reviewed by a native speaker; must stay needs_review until a human native-speaker pass (decision D9).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have no source for this. Ask: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No tenemos fuente para esto. Pregunte a: %@"
          }
        },
        "ht": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nou pa gen sous pou sa. Mande: %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não temos fonte para isso. Pergunte: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous n’avons pas de source. Demandez : %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ليس لدينا مصدر لهذا. اسأل: %@"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有来源。请问：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет источника. Спросите: %@"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Walang source. Tanungin: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có nguồn. Hỏi: %@"
          }
        }
      }
    },
